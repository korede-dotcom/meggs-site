ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Keep the secret key on the server. Begin with a Paystack TEST key.
PAYSTACK_SECRET_KEY=
# Public HTTPS origin in production; localhost works for test redirects.
SITE_URL=http://localhost:3000
PORT=3000
# Set NODE_ENV=production on HTTPS deployments for secure admin cookies.
# PostgreSQL: create this database and user before running db:migrate.
DATABASE_URL=postgres://meggs:change-this-password@127.0.0.1:5432/meggs
DB_POOL_MAX=10
# Enable for remote providers requiring TLS; certificates are verified.
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Docker Compose only: use a long hexadecimal password (for example, openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-a-long-hex-password
